{
  "name": "drawnix-desktop",
  "version": "0.0.4",
  "private": true,
  "description": "Drawnix 开源白板桌面版（Windows 10 x64）",
  "author": "Drawnix Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plait-board/drawnix.git"
  },
  "main": "electron/dist/main.js",
  "scripts": {
    "upstream:sync": "node scripts/upstream-sync.js",
    "upstream:check": "node scripts/upstream-sync.js --check",
    "build:renderer": "node scripts/build-renderer.js",
    "verify:renderer": "node scripts/verify-renderer.js",
    "electron:build": "node scripts/build-electron.js",
    "electron:dev": "npm run electron:build && electron .",
    "smoke": "node scripts/smoke.js",
    "dist:win": "npm run build:renderer && npm run electron:build && electron-builder --win --x64 --publish never",
    "dist:win:reuse": "npm run verify:renderer && npm run electron:build && electron-builder --win --x64 --publish never",
    "dev:renderer": "node scripts/dev-renderer.js",
    "typecheck": "node scripts/typecheck.js"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}
